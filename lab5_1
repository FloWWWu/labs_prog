#include <iostream>
#include <cstdlib>
#include <ctime>
#include <clocale>

using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    srand(time(0));
    const int n = 1000;
    int arr[n];
    int N = 0;
    int f;
    int g;

    printf("Введите диапазон генерации (например, -100-100 или 5-50): ");

    while (scanf_s("%d-%d", &f, &g) != 2) {
        printf("ДЕБИЛ! Введите диапазон через дефис (например, -100-100): ");
    }
    if (f > g) {
        int temp = f;
        f = g;
        g = temp;
    }

    printf("Введите количество чисел N (от 1 до %d): ", n);
    while (scanf_s("%d", &N) != 1 || N <= 0 || N > n) {
        printf("ДЕБИЛ! Пожалуйста, введите корректное целое число в указанном диапазоне: ");
    }
    printf("\nСгенерированные целые числа:\n");
    int range = g - f + 1;

    for (int i = 0; i < N; ++i) {
        arr[i] = f + rand() % range;
        printf("%d ", arr[i]);
    }
    printf("\n\n");

    int min_pol = g + 1;
    int max_otr = f - 1;


    for (int i = 0; i < N; ++i) {
        int num = arr[i];
        if (num > 0 && num != 0) {
            if (num < min_pol) {
                min_pol = num;
            }
        }
        else{
            if (num > max_otr) {
                max_otr = num;
            }
        }
    }
    if (min_pol != g + 1) {
        printf("Минимальное положительное число: %d\n", min_pol);
    }
    else {
        printf("Положительные числа не найдены.\n");
    }
    if (max_otr != f-1) {
        printf("Максимальное отрицательное число: %d\n", max_otr);
    }
    else {
        printf("Отрицательные числа не найдены.\n");
    }
}
