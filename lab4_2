#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>
#include <cstdio>   
#include<locale.h>

using namespace std; 

int main() {
    setlocale(LC_ALL, "Russian");
    srand(time(0));
    int arr[1000];
    for (int i = 0; i < 1000; ++i) {
        arr[i] = rand() % 10 + 1;
    }
    double porog = 0;
    while (true) {
        printf("Введите заданное значение (порог): ");

        if (scanf_s("%lf", &porog) != 1) {
            printf("Ошибка: нужно ввести число! Попробуйте еще раз.\n\n");

            int c;
            while ((c = getchar()) != '\n' && c != EOF);
            continue;
        }
        if (porog <= 0) {
            printf("Ошибка! Вы ввели %.0f. Число должно быть положительным.\n\n", porog);
        }
        else {
            break;
        }
    }
    unsigned long long product = 1;
    int k = 0;
    bool f = false;
    for (int i = 1000 - 1; i >= 0; --i) {
        product *= arr[i];
        k++;
        if (product > porog) {
            f = true;
            break;
        }
    }
    if (f) {
        printf("\nНужно перемножить элементов с конца: %d\n", k);
        printf("Итоговое произведение: %llu\n", product);
    }
    else {
        printf("\nДаже перемножив весь массив, порог в %llu не был превышен.\n", porog);
        printf("Итоговое произведение всех элементов: %llu\n", product);
    }
    return 0;
}
