
#include <stdio.h>
#include <locale.h>

const int MAX = 10000;

// Подпрограмма отбора кандидатов
void Otbor(int n, int ocenki[][4], int predmet, const char name[])
{
    int count = 0;

    printf("\nКандидаты на олимпиаду по предмету %s:\n", name);

    for (int i = 0; i < n; i++)
    {
        if (ocenki[i][predmet] == 5)
        {
            printf("Участник №%d\n", i + 1);
            count++;
        }
    }

    if (count == 0)
        printf("Кандидатов нет.\n");
}

int main()
{
    setlocale(LC_ALL, "Russian");

    int n;
    int ocenki[MAX][4];

    // Ввод количества участников
    printf("Введите количество участников: ");
    scanf("%d", &n);

    if (n < 1 || n > MAX)
    {
        printf("дебил! Количество должно быть > 1\n");
        return 1;
    }

    // Ввод оценок участников
    for (int i = 0; i < n; i++)
    {
        printf("\nВведите оценки участника №%d:\n", i + 1);

        printf("Математика: ");
        scanf("%d", &ocenki[i][0]);

        printf("Физика: ");
        scanf("%d", &ocenki[i][1]);

        printf("Химия: ");
        scanf("%d", &ocenki[i][2]);

        printf("Информатика: ");
        scanf("%d", &ocenki[i][3]);
    }

    // Вывод всех оценок
    printf("\nТаблица оценок:\n");
    printf("№\tМатематика\tФизика\tХимия\tИнформатика\n");

    for (int i = 0; i < n; i++)
    {
        printf("%d\t%d\t\t%d\t%d\t%d\n",
            i + 1,
            ocenki[i][0],
            ocenki[i][1],
            ocenki[i][2],
            ocenki[i][3]);
    }

    // Отбор кандидатов по предметам
    Otbor(n, ocenki, 0, "математике");
    Otbor(n, ocenki, 1, "физике");
    Otbor(n, ocenki, 2, "химии");
    Otbor(n, ocenki, 3, "информатике");

    return 0;
}
